# FAIForge Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Application Settings
# ============================================

# Environment (development, staging, production)
APP_ENV=development

# Server settings
HOST=0.0.0.0
PORT=8000

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================
# OpenAI Configuration
# ============================================

# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Override base URL (for proxies or custom endpoints)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# Anthropic Configuration
# ============================================

# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Override base URL
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ============================================
# Local Model (vLLM) Configuration
# ============================================

# Base URL for your local vLLM server
# Default: http://localhost:8000
VLLM_BASE_URL=http://localhost:8000

# Model name (must match what vLLM is serving)
VLLM_MODEL_NAME=meta-llama/Llama-3-8B

# ============================================
# Observability (Future)
# ============================================

# OpenTelemetry endpoint (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Tracing enabled
# ENABLE_TRACING=true

# ============================================
# Database (Future - v3.0)
# ============================================

# PostgreSQL connection
# DATABASE_URL=postgresql://user:password@localhost:5432/faiforge

# ============================================
# Redis (Future - v2.0)
# ============================================

# Redis for caching
# REDIS_URL=redis://localhost:6379/0

# ============================================
# Security
# ============================================

# API key for authenticating requests (optional for development)
# API_KEY=your_secret_api_key_here

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# Rate Limiting (Future)
# ============================================

# Requests per minute per API key
# RATE_LIMIT_PER_MINUTE=60

# ============================================
# Cost Tracking
# ============================================

# Enable detailed cost tracking
ENABLE_COST_TRACKING=true

# Alert threshold (USD)
# COST_ALERT_THRESHOLD=100.0

# ============================================
# Development
# ============================================

# Enable debug mode (more verbose logging)
DEBUG=false

# Auto-reload on code changes
AUTO_RELOAD=true

# ============================================
# Notes
# ============================================

# - Never commit .env to version control
# - Keep .env.example up to date
# - Use strong, unique values in production
# - Consider using secrets management (AWS Secrets Manager, etc.)
